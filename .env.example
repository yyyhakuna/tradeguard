# Copy to .env and fill in. .env is gitignored — never commit real keys.

# DMX platform (https://www.dmxapi.com/v1) — used by createLlm({ platform: "dmx" }).
DMX_API_KEY=sk-your-dmx-key

# Optional other platforms (createLlm({ platform: "openai" | "deepseek" }))
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# Block-explorer key for the LiveReputationProvider contract checks (BscScan/Etherscan V2).
# BSCSCAN_KEY=...

# Binance Agent OS OAuth uses URL-based client ids (CIMD) — no portal registration.
# `npm run agentos:login` writes agent-os-client.json; host it at a public HTTPS URL,
# set client_id inside it to that same URL, then point this at it and re-run login.
# AGENT_OS_CLIENT_METADATA_URL=https://your-host/agent-os-client.json
# AGENT_OS_URL=https://agent.binance.com/mcp/agentic   # override the endpoint (optional)
# AGENT_OS_CLIENT_ID=...            # only for servers that pre-register clients (not Agent OS)
